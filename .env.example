# Docker Compose uchun: server
# Hostda (IDE) ishlatish uchun: local
SPRING_PROFILES_ACTIVE=server

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mail (Gmail SMTP app password)
MAIL_USERNAME=
MAIL_PASSWORD=

# JWT — `openssl rand -base64 48` bilan yarating.
# MUHIM: qiymatda $ belgisi bo'lmasin, Compose uni o'zgaruvchi deb o'qiydi.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Postgres (server profili va docker-compose ishlatadi)
POSTGRES_DB=famousbooks
POSTGRES_USER=famousbooks
POSTGRES_PASSWORD=
